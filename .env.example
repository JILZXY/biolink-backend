# ==============================================================================
# BioLink Backend - Configuracion de Entorno de Ejemplo
# Copie este archivo a .env localmente y reemplace las credenciales de ejemplo.
# NUNCA versione .env ni coloque secretos reales en este archivo.
# ==============================================================================

# --- Aplicacion y API REST ---
APP_NAME=biolink-backend
APP_ENV=development
APP_VERSION=0.1.0
API_V1_PREFIX=/api/v1
LOG_LEVEL=INFO
LOG_FORMAT=json

# --- Servidor y Red ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
# Lista separada por comas o arreglo JSON de origenes permitidos (prohibido "*")
CORS_ALLOWED_ORIGINS=http://127.0.0.1:3000,http://localhost:3000

# --- Seguridad y Sesiones (sin registro publico en V1) ---
AUTH_SECRET_KEY=REPLACE_WITH_LONG_RANDOM_SECRET_MIN_32_CHARACTERS
SESSION_COOKIE_NAME=biolink_session
SESSION_TTL_HOURS=12
SESSION_COOKIE_SECURE=false

# --- Presupuesto de Memoria del Backend + Worker (maximo conjunto: 512 MiB) ---
BACKEND_MEM_LIMIT_MB=320
WORKER_MEM_LIMIT_MB=192

# --- PostgreSQL 18.7 (Fuente de Verdad Relacional - max 768 MiB) ---
POSTGRES_IMAGE=postgres:18.7
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
POSTGRES_DB=biolink
POSTGRES_USER=biolink_app
POSTGRES_PASSWORD=CHANGE_ME_PG_SECRET
POSTGRES_POOL_MIN_SIZE=2
POSTGRES_POOL_MAX_SIZE=10
POSTGRES_CONNECT_TIMEOUT_SEC=5.0
POSTGRES_STATEMENT_TIMEOUT_MS=10000
POSTGRES_MEM_LIMIT_MB=768

# --- MongoDB Community 8.0.38 (Expedientes Documentales - max 768 MiB) ---
MONGODB_IMAGE=mongo:8.0.38
MONGODB_HOST=127.0.0.1
MONGODB_PORT=27017
MONGODB_DB=biolink_documents
MONGODB_USER=biolink_app
MONGODB_PASSWORD=CHANGE_ME_MONGO_SECRET
MONGODB_AUTH_SOURCE=admin
MONGODB_MIN_POOL_SIZE=1
MONGODB_MAX_POOL_SIZE=10
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=10000
MONGODB_MEM_LIMIT_MB=768

# --- Neo4j Community 2026.10.2 (Proyeccion de Grafo - max 1024 MiB) ---
NEO4J_IMAGE=neo4j:2026.10.2-community
NEO4J_HOST=127.0.0.1
NEO4J_BOLT_PORT=7687
NEO4J_HTTP_PORT=7474
NEO4J_USER=neo4j
NEO4J_PASSWORD=CHANGE_ME_NEO4J_SECRET
NEO4J_MAX_CONNECTION_POOL_SIZE=15
NEO4J_CONNECTION_TIMEOUT_SEC=5.0
NEO4J_MAX_TRANSACTION_RETRY_TIME_SEC=15.0
NEO4J_MEM_LIMIT_MB=1024
NEO4J_HEAP_INITIAL=256m
NEO4J_HEAP_MAX=384m
NEO4J_PAGECACHE=256m
NEO4J_TX_TOTAL_MAX=256m
NEO4J_TX_MAX=64m

# --- Transactional Outbox Worker ---
OUTBOX_POLL_INTERVAL_SEC=2.0
OUTBOX_BATCH_SIZE=50
OUTBOX_MAX_ATTEMPTS=5
